{
	"name": "ytdownloader",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@types/node": "^26.4.1"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo run dev -F native --",
		"check": "biome check --write .",
		"test": "turbo run test",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/node": "catalog:",
		"@yt/config": "workspace:*",
		"turbo": "^2.11.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.4.4"
}
